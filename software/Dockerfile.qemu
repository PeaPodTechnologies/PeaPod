# Builds the image for running the software with QEMU (Raspberry Pi emulation)
FROM archlinux:latest AS peapodos-qemu

RUN sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf \
    && pacman -Syu --noconfirm --needed \
    qemu-full \
    mtools \
    parted \
    ca-certificates \
    bash \
    && pacman -Scc --noconfirm


COPY scripts/qemu.sh /usr/local/bin/boot-qemu

RUN chmod +x /usr/local/bin/boot-qemu

ENTRYPOINT ["/usr/local/bin/boot-qemu"]