{
  "name": "@peapodtech/peapodos",
  "version": "0.3.8",
  "description": "Main software for PeaPod.",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "api/*.mjs",
    "microcontroller/lib/I2CIP/lib/**/*.c",
    "microcontroller/lib/I2CIP/lib/**/*.cc",
    "microcontroller/lib/I2CIP/lib/**/*.cpp",
    "microcontroller/lib/I2CIP/lib/**/*.h",
    "microcontroller/lib/I2CIP/lib/**/*.hpp",
    "microcontroller/lib/I2CIP/lib/**/library.json",
    "microcontroller/lib/I2CIP/lib/**/library.properties",
    "microcontroller/lib/I2CIP/lib/**/LICENSE",
    "microcontroller/lib/I2CIP/src/",
    "microcontroller/lib/I2CIP/test/",
    "microcontroller/lib/I2CIP/I2CIP.h",
    "microcontroller/lib/I2CIP/LICENSE",
    "microcontroller/src/",
    "microcontroller/test/",
    "microcontroller/platformio.ini",
    "microcontroller/README.md",
    "public/",
    ".next/",
    "!.next/cache",
    "flash.mjs",
    "index.mjs",
    "serialtest.mjs",
    "server.mjs",
    ".env.template",
    "*.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "preferGlobal": true,
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "yarn buildapi && yarn start",
    "devsim": "yarn buildapi && yarn startsim",
    "build": "yarn buildapi && next build",
    "buildapi": "rm -f api/*.mjs index.mjs server.mjs serialtest.mjs flash.mjs && node api.esbuild.mjs",
    "start": "node index.mjs",
    "startsim": "node index.mjs --simulator",
    "lint": "next lint --fix",
    "deploy_functions": "firebase deploy --only functions",
    "prepublishOnly": "./scripts/pack.sh",
    "publish": "npm publish ./dist/peapodos.tgz --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeaPodTechnologies/PeaPod.git"
  },
  "keywords": [
    "iot",
    "firebase",
    "agriculture"
  ],
  "author": "PeaPod Technologies",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeaPodTechnologies/PeaPod/issues"
  },
  "homepage": "https://github.com/PeaPodTechnologies/PeaPod#readme",
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@inquirer/prompts": "^8.1.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/material-nextjs": "^7.3.0",
    "@mui/x-charts": "^8.10.0",
    "@mui/x-data-grid": "^8.10.1",
    "@mui/x-date-pickers": "^9.0.4",
    "@peapodtech/firebasedeviceflow": "^0.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "chalk": "^5.4.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "firebase": "^12.7.0",
    "json-edit-react": "^1.29.0",
    "next": "15.1.3",
    "ora": "^8.1.1",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.11",
    "uuid": "^11.0.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.17.0",
    "@types/blessed": "^0.1.25",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.24.2",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "globals": "^15.14.0",
    "prettier": "3.4.2",
    "typescript": "^5",
    "typescript-eslint": "^8.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "peapodos": "index.mjs"
  }
}
